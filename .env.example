# KAIRAS OS — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores.

# --- Base de datos (PostgreSQL) ---
# Desarrollo local: `npm run db:dev` arranca Prisma Postgres local y muestra la URL.
# Producción (Supabase): DATABASE_URL = Transaction pooler (:6543) con
#   ?sslmode=require&pgbouncer=true ;
#   DIRECT_DATABASE_URL = Session pooler (:5432) con ?sslmode=require.
#   NO usar la Direct connection db.xxx.supabase.co (solo IPv6 en free).
# NO añadas connection_limit=1: con un solo enlace Prisma serializa y los
#   Promise.all de las páginas dejan de ir en paralelo. Ver docs/deployment.md.
DATABASE_URL=""
# Opcional. Tamaño del pool de Prisma; por defecto 10. Bajarlo solo si el
# pooler de Supabase se queda sin enlaces con mucha concurrencia.
DATABASE_CONNECTION_LIMIT=""
# Migraciones (prisma migrate deploy). En local: la misma URL que DATABASE_URL.
DIRECT_DATABASE_URL=""
# Solo para generar diffs de migración en local:
SHADOW_DATABASE_URL=""

# --- Auth.js ---
# Genera un secreto con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"
# "production" oculta el badge LOCAL. Cualquier otro valor lo muestra.
APP_ENV="development"
DEFAULT_TIMEZONE="Europe/Madrid"
DEFAULT_CURRENCY="EUR"
# IMPORTANTE en producción (Vercel corre en UTC): fija TZ para que los
# campos de fecha/hora de los formularios se interpreten en hora española.
# TZ solo aplica fuera de Vercel (variable reservada alli); el codigo no la necesita
TZ="Europe/Madrid"

# --- Usuaria inicial (usada solo por `npm run db:seed`) ---
SEED_USER_EMAIL=""
SEED_USER_NAME=""
SEED_USER_PASSWORD=""

# --- Archivos adjuntos (Supabase Storage) ---
# Vacíos = driver local (.uploads/, solo desarrollo; en Vercel NO persiste).
# Producción: Project URL + service_role key (Settings → API) y bucket PRIVADO.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="kairas-files"
# Límite de subida en MB (mantener <4.5 por el límite de body de Vercel)
MAX_FILE_MB="4"

# --- Meta Conversions API ---
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""
META_API_VERSION="v23.0"

# --- Odoo ---
# Odoo 19 JSON-2: usa el origen de la instancia, por ejemplo
# https://tu-instancia.odoo.com, sin `/odoo` al final.
ODOO_BASE_URL=""
# Opcional. Solo si el servidor aloja varias bases y requiere
# X-Odoo-Database. Debe ser el NOMBRE de la base, nunca una URL.
ODOO_DB=""
# Se conserva como referencia del usuario bot, pero JSON-2 autentica con la key.
ODOO_USERNAME=""
# API key de un usuario dedicado con permiso Read y sin Write/Create/Delete.
ODOO_API_KEY=""
# api | csv | playwright
ODOO_INTEGRATION_MODE="csv"

# --- Backups (opcional, ver docs/backups.md) ---
BACKUP_PROVIDER=""
BACKUP_BUCKET=""
BACKUP_ACCESS_KEY=""
BACKUP_SECRET_KEY=""

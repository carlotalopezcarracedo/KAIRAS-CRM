# KAIRAS OS — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores.

# --- Base de datos (PostgreSQL) ---
# Desarrollo local: `npm run db:dev` arranca Prisma Postgres local y muestra la URL.
# Producción: usa la connection string de Supabase / Neon / tu Postgres.
DATABASE_URL=""
# Solo necesaria para `prisma migrate dev` con algunos proveedores:
SHADOW_DATABASE_URL=""

# --- Auth.js ---
# Genera un secreto con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"
APP_ENV="development"
DEFAULT_TIMEZONE="Europe/Madrid"
DEFAULT_CURRENCY="EUR"

# --- Usuaria inicial (usada solo por `npm run db:seed`) ---
SEED_USER_EMAIL=""
SEED_USER_NAME=""
SEED_USER_PASSWORD=""

# --- Meta Conversions API ---
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""
META_API_VERSION="v23.0"

# --- Odoo ---
ODOO_BASE_URL=""
ODOO_DB=""
ODOO_USERNAME=""
ODOO_API_KEY=""
# api | csv | playwright
ODOO_INTEGRATION_MODE="csv"

# --- Backups (opcional, ver docs/backups.md) ---
BACKUP_PROVIDER=""
BACKUP_BUCKET=""
BACKUP_ACCESS_KEY=""
BACKUP_SECRET_KEY=""
